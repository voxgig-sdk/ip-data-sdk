# Entity: get_ip_info

main: kit: entity: get_ip_info: {

  alias: field: {}

  fields: [
    {
      name: "asn"
      req: false
      short: "Information about the autonomous system that routes the IP address"
      type: "`$OBJECT`"
    }
    {
      name: "company"
      req: false
      short: "Information about the organization that owns the IP address (from WHOIS data)"
      type: "`$OBJECT`"
    }
    {
      name: "elapsed_ms"
      req: false
      short: "API processing time in milliseconds"
      type: "`$NUMBER`"
    }
    {
      name: "ip"
      req: false
      short: "The queried IP address"
      type: "`$STRING`"
    }
    {
      name: "is_abuser"
      req: false
      short: "Whether the IP has been involved in malicious activities"
      type: "`$BOOLEAN`"
    }
    {
      name: "is_bogon"
      req: false
      short: "Whether the IP is a bogon (reserved/private IP)"
      type: "`$BOOLEAN`"
    }
    {
      name: "is_crawler"
      req: false
      short: "Whether the IP is from a known web crawler"
      type: "`$BOOLEAN`"
    }
    {
      name: "is_datacenter"
      req: false
      short: "Whether the IP is from a datacenter or hosting provider"
      type: "`$BOOLEAN`"
    }
    {
      name: "is_mobile"
      req: false
      short: "Whether the IP is from a mobile network"
      type: "`$BOOLEAN`"
    }
    {
      name: "is_proxy"
      req: false
      short: "Whether the IP is a known proxy"
      type: "`$BOOLEAN`"
    }
    {
      name: "is_tor"
      req: false
      short: "Whether the IP is a Tor exit node"
      type: "`$BOOLEAN`"
    }
    {
      name: "is_vpn"
      req: false
      short: "Whether the IP is from a VPN service"
      type: "`$BOOLEAN`"
    }
    {
      name: "location"
      req: false
      short: "Geographic location information for the IP address"
      type: "`$OBJECT`"
    }
    {
      name: "rir"
      req: false
      short: "Regional Internet Registry (ARIN, APNIC, RIPE, AFRINIC, LACNIC)"
      type: "`$STRING`"
    }
  ]

  name: "get_ip_info"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                example: "json"
                kind: "query"
                name: "format"
                orig: "format"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "23.236.48.55"
                kind: "query"
                name: "q"
                orig: "q"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/"
          select: {
            exist: [
              "format"
              "q"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
